{
  "expo": {
    "name": "daybook",
    "slug": "daybook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daybook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vaughnscherer.daybook",
      "appleTeamId": "CJVU73XF2V"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161616",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Daybook reads a photo you pick of a syllabus, handout or whiteboard to add its dates to your calendar.",
          "cameraPermission": "Daybook reads a photo you take of a syllabus, handout or whiteboard to add its dates to your calendar.",
          "microphonePermission": false
        }
      ],
      "./plugins/without-push-entitlement",
      "./plugins/with-scene-lifecycle",
      "./plugins/with-siri-shortcut",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Daybook shows your Apple and Google calendars and keeps them in sync with your Daybook events."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
